# Database
DATABASE_URL="postgresql://ozon:ozon69@localhost:5432/ozon"

# =============================================================================
# AUTHENTICATION URLs - Same value for both, used for different purposes:
#
# BETTER_AUTH_URL: Your NestJS API server base URL (used by better-auth for
#                  email links, cookie settings, and OAuth callbacks)
# NEXT_PUBLIC_API_URL: Exposed to browser - same URL so client can call API
#
# In DEVELOPMENT: both = http://localhost:3001
# In PRODUCTION: both = https://api.yourdomain.com (your API domain)
# =============================================================================
BETTER_AUTH_URL="http://localhost:3001"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Frontend URL (your Next.js app) - used for CORS and email callbacks
# In DEVELOPMENT: http://localhost:3000
# In PRODUCTION: https://yourdomain.com
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth Secrets
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-super-secret-key-minimum-32-characters-long"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# PostgreSQL (Docker)
POSTGRES_USER=ozon
POSTGRES_PASSWORD=ozon69
POSTGRES_DB=ozon

# Redis
REDIS_PASSWORD=redis_password

# Server
PORT=3001

# Email (Resend)
RESEND_API_KEY="your_resend_api_key"

# DEV ONLY - Remove in production
# Dev override to redirect all emails to your personal email (Resend free tier)
# DEV_EMAIL_OVERRIDE="your-email@example.com"

# Deepgram STT
DEEPGRAM_API_KEY="your_deepgram_key"
DEEPGRAM_PROJECT_ID="your_project_id"

SST_MAX_KEYS_PER_WINDOW=6
SST_KEY_WINDOW_MS=60000

# Mistral OCR
MISTRAL_API_KEY="your_mistral_key"
NODE_ENV= 