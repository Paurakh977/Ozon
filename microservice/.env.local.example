# Server Configuration
PORT=3001
NODE_ENV=development

# Next.js App URL (Required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth Configuration (Required)
# Generate a secret using: openssl rand -base64 32
BETTER_AUTH_SECRET=your_32_character_secret
BETTER_AUTH_URL=http://localhost:3001

# Database Configuration (Required)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://ozon:ozon69@localhost:5432/ozon

# Redis Configuration (Required for rate limiting)
REDIS_URL=redis://localhost:6379

# Resend API Key for Email (Required for authentication emails)
RESEND_API_KEY=your_resend_api_key
# DEV_EMAIL_OVERRIDE redirects all emails to this address. Keep it active locally so emails don't bounce.
DEV_EMAIL_OVERRIDE=your_email@gmail.com

# Session and Rate Limiting Options (Optional overrides with current defaults)
# SESSION_EXPIRES_IN=604800 (7 days in seconds)
# SESSION_UPDATE_AGE=86400 (1 day in seconds)
# SESSION_COOKIE_MAX_AGE=300 (5 mins in seconds)
# RATE_LIMIT_WINDOW=60 (in seconds)
# RATE_LIMIT_MAX=20
# TWO_FACTOR_TOTP_PERIOD=30
# TWO_FACTOR_OTP_PERIOD=3
# TWO_FACTOR_OTP_ATTEMPTS=5
# TWO_FACTOR_BACKUP_AMOUNT=10
# TWO_FACTOR_BACKUP_LENGTH=10
# TWO_FACTOR_COOKIE_MAX_AGE=600
# TRUST_DEVICE_MAX_AGE=2592000 (30 days in seconds)

# OAuth Configuration (Google & GitHub)
# Google: Setup in Google Cloud Console -> APIs & Services -> Credentials
# Callback URL needed: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# GitHub: Setup in GitHub Developer Settings -> OAuth Apps
# Callback URL needed: http://localhost:3001/api/auth/callback/github
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Deepgram STT Configuration (Required for voice features)
DEEPGRAM_API_KEY=your_deepgram_api_key
DEEPGRAM_PROJECT_ID=your_deepgram_project_id

# Rate limiting configuration (Optional)
SST_MAX_KEYS_PER_WINDOW=6
SST_KEY_WINDOW_MS=60000

# Mistral OCR Configuration (Required for OCR features)
MISTRAL_API_KEY=your_mistral_api_key
