# Setup for local development (no Docker)

# NextJS app url (Required)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Better Auth API Server URL (Required for client auth)
NEXT_PUBLIC_API_URL=http://localhost:3001

# AI Agent WebSocket (Required)
NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8000/ws

# Math gRPC Server (Required)
GRPC_SERVER_URL=localhost:50051

# API keys for client-side processing
DEEPGRAM_API_KEY=your_deepgram_key
MISTRAL_API_KEY=your_mistral_key

# Optional settings
SST_MAX_KEYS_PER_WINDOW=6
SST_KEY_WINDOW_MS=60000
