# Setup for production (Docker + Nginx HTTPS)

# NextJS app url (Required)
NEXT_PUBLIC_APP_URL=https://localhost

# Better Auth API Server URL (Required for client auth)
NEXT_PUBLIC_API_URL=https://localhost

# AI Agent WebSocket (Required)
NEXT_PUBLIC_AGENT_WS_URL=wss://localhost/ws

# Math gRPC Server (Required)
GRPC_SERVER_URL=ozon-grpc-server:50051

# Redis Configuration (Required - must match microservice/.env)
REDIS_PASSWORD=your_strong_redis_password

# API keys for client-side processing
DEEPGRAM_API_KEY=your_deepgram_key
MISTRAL_API_KEY=your_mistral_key

# Optional settings
SST_MAX_KEYS_PER_WINDOW=6
SST_KEY_WINDOW_MS=60000
