GRPC_SERVER_URL=localhost:50051  #ozon-grpc-server:50051 for docker container


NEXT_PUBLIC_AGENT_WS_URL=ws://localhost:8000/ws

DEEPGRAM_API_KEY=sk_live_xxx
DEEPGRAM_PROJECT_ID=proj_xxx


MISTRAL_API_KEY=sk_live_xxx
MISTRAL_MODEL_NAME=mistral-ocr-latest


# Rate limiting + key TTL THIS IS TEMPORARY 
SST_MAX_KEYS_PER_WINDOW=6
SST_KEY_WINDOW_MS=60000
SST_CLIENT_KEY_TTL_SEC=60
SST_MAX_KEYS_PER_DAY=200
SST_IP_BLOCK_MS=900000

# Optional protections
SST_ALLOWED_ORIGIN=https://app.example.com
SST_REQUIRE_AUTH=false

# Production: centralized store for limits (recommended)
SST_RATE_LIMIT_REDIS_URL=redis://:password@redis-host:6379/0